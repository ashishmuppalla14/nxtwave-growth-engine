# Copy to .env for local use (never commit .env). On Render, set these in the dashboard.
PORT=4000
# Comma-separated list of allowed frontend origins (no trailing slash). Example: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Supabase: Project Settings -> Database -> Connection string -> URI (use the Session pooler string). Leave empty for in-memory local mode.
DATABASE_URL=
# Secret required to download the registration CSV (contains emails). Use a long random value.
ADMIN_KEY=
# Set to "false" to skip inserting the simulated seed data into an empty database.
SEED_DEMO_DATA=true
